  "detection_rules": {
    "_comment": "Scene detection rules with token patterns",

    "facility": {
      "required_tokens": ["exterior", "building"],
      "negative_tokens": ["interior", "room", "inside"],
      "nice_to_have": ["clinic", "office", "entrance"],
      "priority": 100,
      "confidence_threshold": 0.7
    },

    "team": {
      "required_tokens": ["team", "people"],
      "negative_tokens": ["logo", "screenshot", "individual"],
      "nice_to_have": ["group", "staff", "employees"],
      "priority": 90,
      "confidence_threshold": 0.7
    },

    "product": {
      "required_tokens": ["white", "background"],
      "negative_tokens": ["person", "landscape"],
      "nice_to_have": ["product", "isolated", "studio"],
      "priority": 85,
      "confidence_threshold": 0.7
    },

    "service-icon": {
      "dimension_constraints": {
        "max_width": 800,
        "max_height": 800
      },
      "filename_patterns": ["*-icon.*", "*icon.*"],
      "priority": 80,
      "confidence_threshold": 0.6
    }
  },

  "filename_patterns": {
    "_comment": "Filename generation patterns with truncation rules",

    "team": {
      "pattern": "{business_name_slug}-team-{name_slug}",
      "max_words": 4,
      "fallback": "{business_name_slug}-team-member"
    },

    "facility": {
      "pattern": "{business_name_slug}-facility-{location_slug}",
      "max_words": 4,
      "fallback": "{business_name_slug}-facility"
    },

    "testimonial": {
      "pattern": "{client_or_patient}-testimonial-{subject_slug}-{location_slug}",
      "max_words": 4,
      "prefix_by_industry": {
        "medical": "patient",
        "dental": "patient",
        "generic": "client"
      }
    },

    "service-icon": {
      "pattern": "{concept_slug}-icon-{location_slug}",
      "max_words": 3
    },

    "product": {
      "pattern": "{product_slug}-{location_slug}",
      "max_words": 4
    },

    "equipment": {
