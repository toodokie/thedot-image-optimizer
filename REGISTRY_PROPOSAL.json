        "_inherits": "generic",
        "title": "Medical Equipment – {business_name}",
        "alt_text": "Professional medical equipment at {business_name}",
        "caption": "Advanced medical technology",
        "description": "Professional medical equipment used for patient care at {business_name}{location_phrase}."
      }
    },

    "business": {
      "generic": {
        "_comment": "Fallback for unclassified business images",
        "title": "{descriptor} – {business_name}",
        "alt_text": "{descriptor} at {business_name}",
        "caption": "{descriptor_label}",
        "description": "{descriptor}{location_phrase}. {uvp}",
        "filename_pattern": "{descriptor_slug}-{business_name_slug}-{location_slug}",
