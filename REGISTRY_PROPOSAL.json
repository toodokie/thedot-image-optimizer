  "confidence_scoring": {
    "_comment": "Rules for calculating metadata confidence scores",

    "filename_quality": {
      "bonus_business_name": 5,
      "bonus_location": 3,
      "penalty_generic_word": -5,
      "penalty_long_slug": -10,
      "generic_words": ["image", "photo", "picture", "file", "attachment"]
    },

    "context_match": {
      "manual_override": 100,
      "ai_generated": 90,
      "token_match_high": 80,
      "token_match_medium": 60,
      "heuristic_fallback": 40
    }
  },

  "usage_notes": {
    "_implementation": "MSH_Template_Registry class loads this JSON and provides get_template() method",
    "_migration": "Gradually migrate hardcoded templates to this registry structure",
    "_extensibility": "Sites can override templates by creating custom JSON files",
    "_versioning": "Each template can have version field for change tracking",
    "_testing": "A/B testing supported via 'variant' field in templates",

    "example_usage": {
      "_comment": "PHP code example for using registry",
      "code": "
        $registry = MSH_Template_Registry::get_instance();
        $template = $registry->get_template(
          'facility',           // scene
          'medical',           // industry
          array(               // variables
            'business_name' => 'Main Street Health',
            'location' => 'Toronto, Ontario',
            'uvp' => 'Evidence-based care'
          )
        );

        // Returns:
        // array(
        //   'title' => 'Main Street Health Medical Facility',
        //   'alt_text' => 'Interior view of Main Street Health medical facility in Toronto, Ontario',
        //   'caption' => 'Modern medical facility at Main Street Health',
        //   'description' => 'Modern medical facility at Main Street Health in Toronto, Ontario. Professional medical practice with state-of-the-art equipment.',
        //   'filename_pattern' => 'mainstreet-health-facility-toronto-ontario',
        //   'confidence' => 80,
        //   'source' => 'registry'
        // )
      "
    }
  }
