{
  "_comment": "TinyDot Template Registry Proposal - Industry-Agnostic Architecture",
  "_version": "1.0.0",
  "_generated": "2025-10-26",
  "_purpose": "Migrate hardcoded PHP templates to JSON-based registry with inheritance",

  "meta": {
    "schema_version": "1.0",
    "default_locale": "en",
    "supported_locales": ["en", "fr", "es", "de"],
    "default_industry": "generic",
    "variable_prefix": "{",
    "variable_suffix": "}"
  },

  "variables": {
    "_comment": "Global variables available to all templates",
    "business": {
      "business_name": {
        "type": "string",
        "source": "msh_onboarding_context.business_name",
        "fallback": "business",
        "example": "Main Street Health"
      },
      "location": {
        "type": "string",
        "source": "computed",
        "format": "{city}, {region}",
        "fallback": "",
        "example": "Toronto, Ontario"
      },
      "location_slug": {
        "type": "string",
        "source": "computed",
        "format": "slugified({city}-{region})",
        "example": "toronto-ontario"
      },
      "city": {
        "type": "string",
        "source": "msh_onboarding_context.city",
        "example": "Toronto"
      },
      "service_area": {
        "type": "string",
        "source": "msh_onboarding_context.service_area",
        "fallback": "{location}",
        "example": "Greater Toronto Area"
      },
      "industry": {
        "type": "string",
        "source": "msh_onboarding_context.industry",
        "example": "medical"
      },
      "industry_label": {
        "type": "string",
        "source": "computed",
        "lookup": "industry_labels",
        "example": "Medical Practice"
      }
    },
    "context": {
      "descriptor": {
        "type": "string",
        "source": "context.visual_descriptor",
        "fallback": "",
        "example": "modern reception area"
      },
      "subject_name": {
        "type": "string",
        "source": "context.subject_name",
        "fallback": "",
        "example": "Sarah Johnson"
      },
      "service": {
        "type": "string",
        "source": "context.service",
        "fallback": "",
        "example": "physiotherapy"
      }
    },
    "onboarding": {
      "uvp": {
        "type": "string",
        "source": "msh_onboarding_context.uvp",
        "fallback": "",
        "example": "Evidence-based care with personalized treatment plans"
      },
      "target_audience": {
        "type": "string",
        "source": "msh_onboarding_context.target_audience",
        "fallback": "",
        "example": "Patients seeking rehabilitation"
      }
    }
  },

  "scenes": {
